{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Transcriber",
  "version": "0.1.0",
  "identifier": "com.chuongtong.meetingtranscriber",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Meeting Transcriber",
        "width": 1320,
        "height": 900,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/macos-capture-helper"],
    "targets": "all",
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
