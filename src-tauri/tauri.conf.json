{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meeting Recap App",
  "version": "0.1.0",
  "identifier": "com.stagoo.meetingrecap",
  "build": {
    "beforeDevCommand": "cd frontend && npm run dev",
    "beforeBuildCommand": "cd frontend && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meeting Recap App",
        "width": 1440,
        "height": 920,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "externalBin": [
      "binaries/backend-sidecar"
    ]
  }
}